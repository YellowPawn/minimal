{
  "manifest_version": 2,
  "name": "Minimal App 2",
  "display": "fullscreen",
  "author": "Brian McBarron",
  "version": "1.0.0",
  "id": "minimal-app-2",
  "start_url": "/",
  "theme_color": "#ef4b81",
  "background_color": "#ffffff",
  "lang": "en",
  "dir": "ltr",
  "orientation": "portrait",
  "description": "Minimal Firebase + SvelteKit SSR app",
  "categories": [
    "entertainment"
  ],
  "icons": [
    {
      "src": "/assets/icon-96.png",
      "sizes": "96x96"
    },
    {
      "src": "/assets/icon-32.png",
      "sizes": "32x32"
    },
    {
      "src": "/assets/icon-16.png",
      "sizes": "16x16"
    }
  ]
}